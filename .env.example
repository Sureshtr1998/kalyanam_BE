# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables. The server refuses to start
# when a "Required" variable is missing (see src/config/env.js).

# --- Required ---
MONGO_URI=mongodb://127.0.0.1:27017/kalyanam
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Frontend origin allowed by CORS (the www/apex twin is allowed automatically).
FRONTEND_URL=https://www.seetharamakalyana.in
# Extra comma-separated CORS origins, e.g. a Vercel preview URL. Localhost is always allowed outside production.
CORS_ORIGINS=

# Razorpay. Use rzp_test_ keys everywhere except production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional, defaults to /user_profiles
IMAGEKIT_FOLDER=

MSG91_AUTHKEY=
MSG91_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_API=

# --- Recommended (features break without them; the server logs a warning) ---
# Razorpay dashboard -> Webhooks -> payment.captured -> <BASE_URL>razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=
QSTASH_TOKEN=
# Shared secret QStash forwards on fulfilment retries.
INTERNAL_ROUTE_SECRET=
# Public API base WITH trailing slash, e.g. https://api.example.com/api/
BASE_URL=

MSG91_WHATSAPP_SENDER_ID=
MSG91_WHATSAPP_API=
MSG91_WHATSAPP_NAMESPACE=

TIMEZONEDB_KEY=
FREE_ASTRO_API_KEY=
OPENAI_API_KEY=

# --- Optional ---
# Meta ad spend on the admin Overview. Business Settings -> System users ->
# generate a token with ads_read for the ad account (set it to never expire).
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=3311139419043676
PORT=5000

# Database backups (Admin -> Backups). Encrypts the copies kept in ImageKit.
# Long random string. SAVE IT IN YOUR PASSWORD MANAGER: cloud backups can't be
# opened without it. e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BACKUP_SECRET=
# Vercel Cron sends this to /api/cron/db-backup for the daily automatic backup.
CRON_SECRET=
# Comma-separated emails charged ₹1 instead of the real price (live smoke tests). Keep empty normally.
TEST_PAYMENT_EMAILS=
# Site-wide cap on photo uploads per day from people not yet registered (each is up to 3 photos). Default 300.
ANON_UPLOAD_DAILY_LIMIT=

# --- Ops agent (admin → Ops tab). Each part stays off until its keys are set. ---
# Claude API key (console.anthropic.com) with a monthly spend limit set there too.
ANTHROPIC_API_KEY=
# Meta: the same system-user token as META_ADS_TOKEN, regenerated with these
# permissions: ads_read, ads_management, pages_show_list, pages_read_engagement,
# pages_manage_engagement, pages_manage_posts, instagram_basic,
# instagram_manage_comments, instagram_content_publish, business_management.
# The Page and its Instagram account are found from the token automatically;
# set these only to pick a different Page.
META_PAGE_ID=
META_IG_USER_ID=
# Conversions API (server-side sign-up events, utils/metaCapi.js). Uses META_ADS_TOKEN
# once the pixel (dataset) is assigned to the system user in Business Settings → Data
# sources → Datasets; or set META_CAPI_TOKEN to a token generated in Events Manager →
# Settings → Conversions API. META_PIXEL_ID defaults to the site's pixel.
# META_CAPI=off turns it off; META_CAPI_TEST_CODE sends to Events Manager → Test events.
META_CAPI_TOKEN=
META_PIXEL_ID=
META_CAPI_TEST_CODE=
# Support inbox (GoDaddy Workspace Email). Password of contactus@.
OPS_MAIL_USER=contactus@seetharamakalyana.in
OPS_MAIL_PASSWORD=
# Google Search Console: the whole service-account JSON key on one line.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE=sc-domain:seetharamakalyana.in
# GitHub fine-grained token for both repos: Contents, Issues, Pull requests (read/write), Deployments (read).
GITHUB_TOKEN=
GITHUB_OWNER=Sureshtr1998
# ImageKit folder where the agent stores the post images it designs.
OPS_POST_FOLDER=/ops-posts
# The "Ops render" workflow gets the backend address and a short-lived pass
# with every request, so it needs no GitHub secrets.
