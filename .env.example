# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables. The server refuses to start
# when a "Required" variable is missing (see src/config/env.js).

# --- Required ---
MONGO_URI=mongodb://127.0.0.1:27017/kalyanam
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Frontend origin allowed by CORS (the www/apex twin is allowed automatically).
FRONTEND_URL=https://www.seetharamakalyana.in
# Extra comma-separated CORS origins, e.g. a Vercel preview URL. Localhost is always allowed outside production.
CORS_ORIGINS=

# Razorpay. Use rzp_test_ keys everywhere except production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional, defaults to /user_profiles
IMAGEKIT_FOLDER=

MSG91_AUTHKEY=
MSG91_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_API=

# --- Recommended (features break without them; the server logs a warning) ---
# Razorpay dashboard -> Webhooks -> payment.captured -> <BASE_URL>razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=
QSTASH_TOKEN=
# Shared secret QStash forwards on fulfilment retries.
INTERNAL_ROUTE_SECRET=
# Public API base WITH trailing slash, e.g. https://api.example.com/api/
BASE_URL=

MSG91_WHATSAPP_SENDER_ID=
MSG91_WHATSAPP_API=
MSG91_WHATSAPP_NAMESPACE=

TIMEZONEDB_KEY=
FREE_ASTRO_API_KEY=
OPENAI_API_KEY=

# --- Optional ---
# Meta ad spend on the admin Overview. Business Settings -> System users ->
# generate a token with ads_read for the ad account (set it to never expire).
META_ADS_TOKEN=EAAZAWTwdaf4YBS3MMqOukBvAo90I7pEyUxyxOH2ZA0AF9eiPmcY8qIZBdZB9bhA8pIYRjGRDtISwq1sbdNh71jwDypqynDA4ey7kj7FedQdhDpBz9gHuJ8sFhtmM9WMGwDf9GXEKwOJ6W3iGoU9kXYyiSSqo89WgYmlreVJAiEWstIdwvpPoNKwUgzfjcQZDZD
META_AD_ACCOUNT_ID=3311139419043676
PORT=5000

# Database backups (Admin -> Backups). Encrypts the copies kept in ImageKit.
# Long random string. SAVE IT IN YOUR PASSWORD MANAGER: cloud backups can't be
# opened without it. e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
BACKUP_SECRET=
# How many cloud backups to keep (default 7, min 2, max 30).
BACKUP_KEEP=
# Vercel Cron sends this to /api/cron/db-backup for the daily automatic backup.
CRON_SECRET=
# Comma-separated emails charged ₹1 instead of the real price (live smoke tests). Keep empty normally.
TEST_PAYMENT_EMAILS=
# Site-wide cap on photo uploads per day from people not yet registered (each is up to 3 photos). Default 300.
ANON_UPLOAD_DAILY_LIMIT=
