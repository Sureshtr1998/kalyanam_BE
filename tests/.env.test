# Fake configuration for the API tests. Never put real keys here: every
# external service (Razorpay, Upstash, MSG91, ImageKit) is mocked in tests/setup.js.
JWT_SECRET=test-jwt-secret-that-is-long-enough-for-hs256-0123456789
FRONTEND_URL=https://www.example.test
CORS_ORIGINS=https://preview.example.test
RAZORPAY_KEY_ID=rzp_test_fake
RAZORPAY_KEY_SECRET=razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=razorpay-webhook-test-secret
UPSTASH_REDIS_REST_URL=https://upstash.example.test
UPSTASH_REDIS_REST_TOKEN=fake
QSTASH_TOKEN=fake
INTERNAL_ROUTE_SECRET=internal-test-secret
BASE_URL=https://api.example.test/api/
IMAGEKIT_PUBLIC_KEY=public_fake
IMAGEKIT_PRIVATE_KEY=private_fake
IMAGEKIT_URL_ENDPOINT=https://ik.example.test/fake
MSG91_AUTHKEY=fake
MSG91_EMAIL_API=https://msg91.example.test/email
MSG91_EMAIL_FROM=no-reply@example.test
MSG91_DOMAIN=example.test
MSG91_WHATSAPP_API=https://msg91.example.test/whatsapp
OPENAI_API_KEY=sk-fake
FREE_ASTRO_API_KEY=fake
